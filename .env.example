# ---- Core ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ezpickle?schema=public"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# 32+ char random string: openssl rand -base64 48
SESSION_SECRET=""

# ---- PayMongo (https://dashboard.paymongo.com) ----
PAYMONGO_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
PAYMONGO_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"
PAYMONGO_WEBHOOK_SECRET="whsk_xxxxxxxxxxxxxxxxxxxx"
# true when using live keys; guards against test events hitting production logic
PAYMONGO_LIVEMODE="false"
# Comma separated, must be enabled on your PayMongo account
PAYMONGO_PAYMENT_METHODS="card,gcash,paymaya,grab_pay,qrph"

# ---- Background jobs ----
# Shared secret for /api/cron/release-holds (Vercel Cron / external scheduler)
CRON_SECRET=""

# ---- Email (optional; notifications are queued to DB if unset) ----
RESEND_API_KEY=""
MAIL_FROM="EzPickle <bookings@ezpickle.ph>"

# ---- Media storage (optional; falls back to URL entry in admin) ----
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="ezpickle-media"

# ---- Dev seed credentials (NEVER set in production) ----
SEED_ENABLED="true"
SEED_PASSWORD="EzPickle!2026"
